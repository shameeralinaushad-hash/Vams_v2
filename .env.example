SECRET_KEY=change-me
FLASK_DEBUG=True

# Max multipart/form-data request body size in MB (quotation/invoice forms
# upload item photos in one request). Default 50. Extraction endpoint files
# are capped separately at 50MB per file.
MAX_CONTENT_LENGTH_MB=50

# Google OAuth (Gmail integration)
# Create a project at https://console.cloud.google.com
# Enable Gmail API → Credentials → OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: http://127.0.0.1:5003/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=